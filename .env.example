# AI assistant: any OpenAI-compatible provider with tool calling. Server only.
# Groq (free):   AI_BASE_URL=https://api.groq.com/openai/v1
#                AI_MODEL=llama-3.3-70b-versatile
# Gemini (free): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: pre-fills the first-run Admin on /setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
